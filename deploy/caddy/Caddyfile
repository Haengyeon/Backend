# haengyeon.site -> 34.64.180.100 A 레코드가 있어야 인증서가 발급된다.
# 도메인을 바꾸려면 아래 한 줄만 수정.

haengyeon.site {
	encode gzip

	# 배포로 컨테이너가 교체되는 몇 초 동안 502를 내지 않고 기다렸다 다시 붙는다
	reverse_proxy app:4000 {
		lb_try_duration 30s
		lb_try_interval 250ms
	}

	log {
		output file /var/log/caddy/access.log
		format console
	}
}
