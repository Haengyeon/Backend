generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// AUTH
// 책임:
// - 카카오 로그인 / 회원가입
// - 인증 정보
// - Refresh Token
// ============================================================

enum AuthProvider {
  KAKAO
}

model Auth {
  id               String       @id @default(uuid())
  userId           String       @unique
  provider         AuthProvider @default(KAKAO)
  kakaoId          String
  refreshTokenHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, kakaoId])
}

// ============================================================
// USER
// 책임:
// - 서비스 회원
// - 프로필
// - 회원 상태
// ============================================================

enum UserStatus {
  ACTIVE
  WITHDRAWN
}

enum Gender {
  MALE
  FEMALE
}

enum Mbti {
  ISTJ
  ISFJ
  INFJ
  INTJ
  ISTP
  ISFP
  INFP
  INTP
  ESTP
  ESFP
  ENFP
  ENTP
  ESTJ
  ESFJ
  ENFJ
  ENTJ
}

enum JobCategory {
  IT_DEVELOPMENT
  DESIGN
  MARKETING
  EDUCATION
  MEDICAL_HEALTH
  LAW
  FINANCE
  ARCHITECTURE_ENGINEERING
  ART_CREATIVE
  FREELANCER
  STUDENT
  RESEARCH
  PUBLIC_ADMINISTRATION
  MEDIA_PUBLISHING
  SERVICE
}

enum Hobby {
  ART
  CAFE
  FOOD
  READING
  EXERCISE
  IT
  COOKING
  SEA
  MOVIE
  EXHIBITION
  PHOTO
  ANIMAL
  MUSIC
  ACTIVITY
  HISTORY
}

model User {
  id        String     @id @default(uuid())
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?

  auth    Auth?
  profile Profile?

  // Matching
  matchings      Matching[]
  matchResponses MatchResponse[]

  // Payment
  payments          Payment[]
  extensionPayments MessageExtensionPayment[]

  // Chat
  chatMessages ChatMessage[]
  chatQuotas   ChatMessageQuota[]

  // Course
  missionPhotos CourseMissionPhoto[]
  courseReviews CourseReview[]

  // Report
  reportsMade     Report[] @relation("Reporter")
  reportsReceived Report[] @relation("ReportedUser")

  // Block
  blocksMade     UserBlock[] @relation("BlockingUser")
  blocksReceived UserBlock[] @relation("BlockedUser")

  // Notification
  notificationSetting NotificationSetting?
  notificationLogs    NotificationLog[]

  // Reward
  pointAccount PointAccount?
  stamps       Stamp[]
}

// ============================================================
// PROFILE
// 카카오 로그인 직후에는 존재하지 않을 수 있음
// 최초 프로필 작성 완료 시 생성
// ============================================================

model Profile {
  id     String @id @default(uuid())
  userId String @unique

  name     String @db.VarChar(20)
  nickname String @db.VarChar(20)

  // 나이는 저장하지 않고 생년월일로 계산
  birthDate DateTime @db.Date

  gender Gender
  mbti   Mbti?

  bio String @db.VarChar(100)

  jobCategory JobCategory
  jobPrivate  Boolean     @default(false)

  hobbies Hobby[]

  profileImageUrl  String @db.VarChar(500)
  fullBodyImageUrl String @db.VarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

// ============================================================
// REGION
// 국내 광역 행정구역
// ============================================================

enum Region {
  SEOUL
  BUSAN
  DAEGU
  INCHEON
  GWANGJU
  DAEJEON
  ULSAN
  SEJONG

  GYEONGGI
  GANGWON

  CHUNGBUK
  CHUNGNAM

  JEONBUK
  JEONNAM

  GYEONGBUK
  GYEONGNAM

  JEJU
}

// ============================================================
// COURSE THEME
//
// 자연 힐링
// 역사 문화
// 야경 데이트
// 사진 명소
// 로컬 맛집 / 전통시장
// 액티비티
// 걷기 여행
// 예술 감성
// ============================================================

enum CourseTheme {
  NATURE_HEALING
  HISTORY_CULTURE
  NIGHT_DATE
  PHOTO_SPOT
  LOCAL_FOOD_MARKET
  ACTIVITY
  WALKING_TRIP
  ART_SENSIBILITY
}

// ============================================================
// MATCHING
//
// Matching
// = 사용자가 시작하는 하나의 매칭 사이클
// = 한 사이클당 MatchAttempt 최대 3회
//
// 첫 후보 실패 이후 RETRY_READY 상태에서 조건 수정 가능
// ============================================================

enum PreferredGender {
  MALE
  FEMALE
  ANY
}

enum MatchingStatus {
  SEARCHING
  WAITING_RESPONSE
  RETRY_READY
  PAYMENT_PENDING
  CONFIRMED
  EXHAUSTED
  CANCELLED
}

model Matching {
  id     String @id @default(uuid())
  userId String

  region Region

  maxDistanceKm Int

  ageMin Int
  ageMax Int

  preferredGender PreferredGender @default(ANY)

  // 1~3개 선택
  // 개수 검증은 DTO / Service에서 수행
  themes CourseTheme[]

  status MatchingStatus @default(SEARCHING)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  endedAt   DateTime?

  user User @relation(fields: [userId], references: [id])

  availableDates MatchingAvailableDate[]

  attemptsAsA MatchAttempt[] @relation("MatchingA")
  attemptsAsB MatchAttempt[] @relation("MatchingB")

  @@index([userId])
  @@index([userId, status])
}

// ============================================================
// MATCHING AVAILABLE DATE
// 사용자가 선택한 여행 가능 날짜
// ============================================================

model MatchingAvailableDate {
  id         String   @id @default(uuid())
  matchingId String
  date       DateTime @db.Date

  matching Matching @relation(fields: [matchingId], references: [id])

  @@unique([matchingId, date])
}

// ============================================================
// MATCH ATTEMPT
//
// 실제 후보 한 명과 연결된 1회의 매칭
//
// Matching A -----
//                 > MatchAttempt
// Matching B -----
//
// 한 Matching은 최대 3개의 Attempt에 참여 가능
// ============================================================

enum MatchAttemptStatus {
  WAITING_RESPONSE
  REJECTED
  PAYMENT_PENDING
  CONFIRMED
  RESPONSE_EXPIRED
  PAYMENT_EXPIRED
  CANCELLED
}

model MatchAttempt {
  id String @id @default(uuid())

  matchingAId String
  matchingBId String

  // 두 Matching 조건의 교집합에서 실제 확정된 값
  region     Region
  theme      CourseTheme
  travelDate DateTime    @db.Date

  status MatchAttemptStatus @default(WAITING_RESPONSE)

  respondDeadlineAt DateTime
  paymentDeadlineAt DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  confirmedAt DateTime?

  matchingA Matching @relation("MatchingA", fields: [matchingAId], references: [id])
  matchingB Matching @relation("MatchingB", fields: [matchingBId], references: [id])

  responses MatchResponse[]
  payments  Payment[]

  chatRoom      ChatRoom?
  courseSession CourseSession?

  reports Report[]
  blocks  UserBlock[]

  @@index([matchingAId])
  @@index([matchingBId])
  @@index([status])
}

// ============================================================
// MATCH RESPONSE
// 각 사용자의 수락 / 거절
// ============================================================

enum MatchDecision {
  ACCEPTED
  REJECTED
}

model MatchResponse {
  id             String        @id @default(uuid())
  matchAttemptId String
  userId         String
  decision       MatchDecision

  respondedAt DateTime @default(now())

  matchAttempt MatchAttempt @relation(fields: [matchAttemptId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  // 한 후보에 한 사용자가 두 번 응답하지 못하도록 제한
  @@unique([matchAttemptId, userId])
}

// ============================================================
// PAYMENT
//
// MatchAttempt 양쪽 사용자가 각각 결제
// 두 명 모두 APPROVED -> MatchAttempt CONFIRMED
// ============================================================

enum PaymentStatus {
  READY
  APPROVED
  CANCELLED
  FAILED
  REFUNDED
}

model Payment {
  id             String @id @default(uuid())
  matchAttemptId String
  userId         String

  amount Int

  // 지역진흥기여금
  regionContributionAmount Int @default(0)

  status PaymentStatus @default(READY)

  kakaoPayTid String? @unique

  approvedAt  DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  matchAttempt MatchAttempt @relation(fields: [matchAttemptId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  // 같은 MatchAttempt에서 사용자당 결제 한 건
  @@unique([matchAttemptId, userId])
}

// ============================================================
// CHAT
//
// 양쪽 결제 완료 후 생성
// D-1부터 OPEN
// ============================================================

enum ChatRoomStatus {
  LOCKED
  OPEN
  CLOSED
  DISABLED
}

model ChatRoom {
  id             String @id @default(uuid())
  matchAttemptId String @unique

  status ChatRoomStatus @default(LOCKED)

  // 여행 날짜 D-1
  openAt DateTime

  createdAt DateTime  @default(now())
  closedAt  DateTime?

  matchAttempt MatchAttempt @relation(fields: [matchAttemptId], references: [id])

  messages ChatMessage[]
  quotas   ChatMessageQuota[]

  extensionPayments MessageExtensionPayment[]
}

// ============================================================
// CHAT MESSAGE
// ============================================================

model ChatMessage {
  id         String @id @default(uuid())
  chatRoomId String
  senderId   String

  // 채팅 한 메시지 최대 200자
  content String @db.VarChar(200)

  createdAt DateTime @default(now())

  chatRoom ChatRoom @relation(fields: [chatRoomId], references: [id])
  sender   User     @relation(fields: [senderId], references: [id])

  @@index([chatRoomId, createdAt])
}

// ============================================================
// CHAT MESSAGE QUOTA
//
// 사용자별 메시지 사용 횟수
// ============================================================

model ChatMessageQuota {
  id         String @id @default(uuid())
  chatRoomId String
  userId     String

  freeCountUsed Int @default(0)
  extendedCount Int @default(0)

  chatRoom ChatRoom @relation(fields: [chatRoomId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([chatRoomId, userId])
}

// ============================================================
// CHAT MESSAGE EXTENSION PAYMENT
// 채팅 횟수 추가 결제
// ============================================================

model MessageExtensionPayment {
  id         String @id @default(uuid())
  chatRoomId String
  userId     String

  extendedCount Int
  amount        Int

  status PaymentStatus @default(READY)

  kakaoPayTid String? @unique

  approvedAt  DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())

  chatRoom ChatRoom @relation(fields: [chatRoomId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@index([chatRoomId])
  @@index([userId])
}

// ============================================================
// COURSE
//
// Course
// = 관광 코스 원본
//
// 한 Course를 여러 CourseSession에서 사용할 수 있음
// ============================================================

model Course {
  id String @id @default(uuid())

  title       String
  region      Region
  theme       CourseTheme
  description String?

  durationMinutes Int?
  thumbnailUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  spots    CourseSpot[]
  missions CourseMission[]
  sessions CourseSession[]
}

// ============================================================
// COURSE SPOT
// 코스 내 실제 방문 장소
// ============================================================

model CourseSpot {
  id       String @id @default(uuid())
  courseId String

  name    String
  address String

  latitude  Float
  longitude Float

  imageUrl String?

  // 방문 순서
  order Int

  course Course @relation(fields: [courseId], references: [id])

  missions CourseMission[]

  @@unique([courseId, order])
}

// ============================================================
// COURSE MISSION
//
// 코스에서 수행해야 하는 미션 정의
// ============================================================

model CourseMission {
  id       String @id @default(uuid())
  courseId String

  // 특정 장소와 연결되지 않은 미션도 허용
  spotId String?

  title       String
  description String?

  order      Int
  isRequired Boolean @default(true)

  course Course      @relation(fields: [courseId], references: [id])
  spot   CourseSpot? @relation(fields: [spotId], references: [id])

  photos CourseMissionPhoto[]

  @@unique([courseId, order])
}

// ============================================================
// COURSE SESSION
//
// 실제 확정된 두 사람이 수행하는 여행
//
// MatchAttempt 1 : 1 CourseSession
// ============================================================

enum CourseSessionStatus {
  UPCOMING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model CourseSession {
  id             String @id @default(uuid())
  courseId       String
  matchAttemptId String @unique

  // 매칭에서 확정된 여행일
  travelDate DateTime @db.Date

  status CourseSessionStatus @default(UPCOMING)

  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course       Course       @relation(fields: [courseId], references: [id])
  matchAttempt MatchAttempt @relation(fields: [matchAttemptId], references: [id])

  missionPhotos CourseMissionPhoto[]
  reviews       CourseReview[]

  video CourseVideo?

  pointTransactions PointTransaction[]
  stamps            Stamp[]
}

// ============================================================
// COURSE MISSION PHOTO
//
// 미션 수행 인증 사진
// 현재: 한 사용자당 한 미션에 사진 1장
// ============================================================

model CourseMissionPhoto {
  id        String @id @default(uuid())
  sessionId String
  missionId String
  userId    String

  imageUrl String  @db.VarChar(500)
  comment  String? @db.VarChar(100)

  createdAt DateTime @default(now())

  session CourseSession @relation(fields: [sessionId], references: [id])
  mission CourseMission @relation(fields: [missionId], references: [id])
  user    User          @relation(fields: [userId], references: [id])

  @@unique([sessionId, missionId, userId])
}

// ============================================================
// COURSE REVIEW
//
// CourseSession 참여자 두 명이 각각 작성 가능
// ============================================================

model CourseReview {
  id        String @id @default(uuid())
  sessionId String
  userId    String

  content String @db.VarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session CourseSession @relation(fields: [sessionId], references: [id])
  user    User          @relation(fields: [userId], references: [id])

  @@unique([sessionId, userId])
}

// ============================================================
// COURSE VIDEO
//
// AI 추억 영상
// CourseSession당 하나
// ============================================================

enum VideoStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model CourseVideo {
  id        String @id @default(uuid())
  sessionId String @unique

  status VideoStatus @default(PENDING)

  videoUrl     String?
  thumbnailUrl String?

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  session CourseSession @relation(fields: [sessionId], references: [id])
}

// ============================================================
// REPORT
//
// 실제 매칭 상대만 신고 가능
// 실제 참여자 검증은 Service에서 수행
// ============================================================

enum ReportReasonCode {
  INAPPROPRIATE_PROFILE
  NO_SHOW
  ABUSE_HARASSMENT
  SUSPECTED_FRAUD
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
}

model Report {
  id             String @id @default(uuid())
  matchAttemptId String

  reporterId     String
  reportedUserId String

  reasonCode  ReportReasonCode
  description String?          @db.VarChar(500)

  status ReportStatus @default(PENDING)

  createdAt  DateTime  @default(now())
  reviewedAt DateTime?

  matchAttempt MatchAttempt @relation(fields: [matchAttemptId], references: [id])

  reporter     User @relation("Reporter", fields: [reporterId], references: [id])
  reportedUser User @relation("ReportedUser", fields: [reportedUserId], references: [id])

  @@unique([reporterId, matchAttemptId])
}

// ============================================================
// BLOCK
//
// 실제 매칭 상대만 차단 가능
// 차단 즉시 채팅 비활성화 + 이후 매칭 후보 제외
// ============================================================

model UserBlock {
  id             String @id @default(uuid())
  matchAttemptId String

  blockingUserId String
  blockedUserId  String

  createdAt DateTime @default(now())

  matchAttempt MatchAttempt @relation(fields: [matchAttemptId], references: [id])

  blockingUser User @relation("BlockingUser", fields: [blockingUserId], references: [id])
  blockedUser  User @relation("BlockedUser", fields: [blockedUserId], references: [id])

  @@unique([blockingUserId, blockedUserId])
}

// ============================================================
// NOTIFICATION
//
// 현재는 카카오 알림 사용 여부
// ============================================================

model NotificationSetting {
  id     String @id @default(uuid())
  userId String @unique

  kakaoEnabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

enum NotificationChannel {
  KAKAO
}

model NotificationLog {
  id     String @id @default(uuid())
  userId String

  channel NotificationChannel

  // MATCH_FOUND
  // MATCH_CONFIRMED
  // CHAT_OPEN
  // COURSE_D1
  // PAYMENT_FAILED 등
  type String

  // SENT / FAILED
  status String

  sentAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

// ============================================================
// REWARD
//
// PointAccount
// = 현재 포인트
//
// PointTransaction
// = 포인트 변경 이력
//
// Stamp
// = 방문한 지역 스탬프
// ============================================================

enum PointTransactionType {
  EARN
  USE
  EXPIRE
}

model PointAccount {
  id     String @id @default(uuid())
  userId String @unique

  balance Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  transactions PointTransaction[]
}

// ============================================================
// POINT TRANSACTION
// ============================================================

model PointTransaction {
  id              String  @id @default(uuid())
  pointAccountId  String
  courseSessionId String?

  type PointTransactionType

  amount       Int
  balanceAfter Int

  reasonCode String

  createdAt DateTime @default(now())

  pointAccount  PointAccount   @relation(fields: [pointAccountId], references: [id])
  courseSession CourseSession? @relation(fields: [courseSessionId], references: [id])
}

// ============================================================
// STAMP
//
// 현재 정책:
// 같은 사용자가 같은 지역 스탬프는 한 번만 획득
// ============================================================

model Stamp {
  id              String @id @default(uuid())
  userId          String
  courseSessionId String

  region Region

  earnedAt DateTime @default(now())

  user          User          @relation(fields: [userId], references: [id])
  courseSession CourseSession @relation(fields: [courseSessionId], references: [id])

  @@unique([userId, region])
}
